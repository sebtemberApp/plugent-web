# ── Sign-in: SEBTEMBER's Firebase Auth (shared login, decided 2026-10-25) ──
# Copy the web app config of sebtember-app-dev (Preview) / sebtember-app (Production):
# Firebase console → Project settings → Your apps → Web app.
NEXT_PUBLIC_SEBTEMBER_FIREBASE_API_KEY=
NEXT_PUBLIC_SEBTEMBER_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_SEBTEMBER_FIREBASE_PROJECT_ID=sebtember-app-dev
NEXT_PUBLIC_SEBTEMBER_FIREBASE_APP_ID=

# ── Plugent's own session cookie ──
# Random, at least 32 characters (e.g. `openssl rand -base64 48`). Rotating it signs everyone out.
PLUGENT_SESSION_SECRET=

# ── Calling sebtember.app's product API (/api/products/{balance,charge}) ──
SEBTEMBER_API_ORIGIN=https://dev.sebtember.app
# Must equal sebtember's PRODUCT_API_AUDIENCE in the same environment.
SEBTEMBER_PRODUCT_API_AUDIENCE=
# The JSON key of the plugent-web service account (one line). Its email must be listed in
# sebtember's PRODUCT_API_CALLERS as `plugent=<email>`.
PLUGENT_SERVICE_ACCOUNT_JSON=
